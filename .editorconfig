root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.rs]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.nsh]
# makensis reads files without a BOM in the system ANSI code page, which
# garbles the Chinese uninstall prompt. Tauri's own NSIS files carry a BOM too.
charset = utf-8-bom
