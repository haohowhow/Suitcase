{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Koofr GUI",
  "version": "2.7.0",
  "identifier": "net.koofr.desktop.gui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Koofr",
        "width": 1280,
        "height": 720,
        "minWidth": 980,
        "minHeight": 640,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://koofr-stream.localhost; img-src 'self' data: blob:; media-src 'self' blob: http://koofr-stream.localhost; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "third_party/libraw-0.21.1": "third_party/libraw-0.21.1"
    }
  }
}
